#!/bin/sh

STATUS_ADDR=0x1efff000
IMAGE=/root/BOOT_QSPI.bin

case "$1" in
	start)
		case " $(cat /proc/cmdline) " in
			*" qspi_program=1 "*) ;;
			*) exit 0 ;;
		esac

		devmem "$STATUS_ADDR" 32 0x51535030
		mtd_index=$(awk -F: '$2 ~ /"qspi-boot"/ { sub(/^mtd/, "", $1); print $1 }' /proc/mtd)
		mtd_device="/dev/mtd${mtd_index}"

		if [ -z "$mtd_index" ] || [ ! -c "$mtd_device" ] || [ ! -f "$IMAGE" ]; then
			echo "QSPI_PROGRAM: missing qspi-boot MTD device or image"
			devmem "$STATUS_ADDR" 32 0x51534641
			exit 1
		fi

		echo "QSPI_PROGRAM: writing $IMAGE to $mtd_device"
		if flashcp -v "$IMAGE" "$mtd_device"; then
			sync
			devmem "$STATUS_ADDR" 32 0x51535031
			echo "QSPI_PROGRAM: PASS"
		else
			devmem "$STATUS_ADDR" 32 0x51534641
			echo "QSPI_PROGRAM: FAIL"
			exit 1
		fi
		;;
esac
