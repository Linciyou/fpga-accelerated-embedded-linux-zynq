/dts-v1/;

// Reuse the proven ZC702 peripheral routing, then override the board-specific
// memory size and add the PL DMA interface generated by this project.
#include "xilinx/zynq-zc702.dts"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Zynq-7020 FFT simulated sampler board";
	compatible = "xlnx,zynq-7020-fft", "xlnx,zynq-7000";

	chosen {
		bootargs = "console=ttyPS1,115200 root=/dev/mmcblk0p2 rootwait rw";
		stdout-path = "serial1:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>;
	};

	axi_dma_fft: dma-controller@40400000 {
		compatible = "xlnx,axi-dma-1.00.a";
		reg = <0x40400000 0x10000>;
		#dma-cells = <1>;
		#address-cells = <1>;
		#size-cells = <1>;
		dma-ranges = <0x0 0x0 0x20000000>;
		clocks = <&clkc 15>, <&clkc 15>, <&clkc 15>, <&clkc 15>;
		clock-names = "s_axi_lite_aclk", "m_axi_mm2s_aclk",
			      "m_axi_s2mm_aclk", "m_axi_sg_aclk";
		xlnx,addrwidth = <32>;
		xlnx,sg-length-width = <23>;

		dma-channel-s2mm {
			compatible = "xlnx,axi-dma-s2mm-channel";
			interrupt-parent = <&intc>;
			interrupts = <0 29 4>;
			xlnx,datawidth = <32>;
			xlnx,include-dre;
		};
	};

	fft_dma: fft-dmaengine@41200000 {
		compatible = "bghjn,zynq7020-fft-dmaengine-2.0";
		reg = <0x41200000 0x1000>;
		reg-names = "capture";
		/* Xilinx AXI DMA assigns S2MM to client channel 1. */
		dmas = <&axi_dma_fft 1>;
		dma-names = "rx";
	};

	phy_reset_gpio: gpio@41210000 {
		compatible = "xlnx,xps-gpio-1.00.a";
		reg = <0x41210000 0x10000>;
		clocks = <&clkc 15>;
		gpio-controller;
		#gpio-cells = <2>;
		xlnx,all-inputs = <0>;
		xlnx,all-outputs = <1>;
		xlnx,dout-default = <0>;
		xlnx,gpio-width = <1>;
		xlnx,interrupt-present = <0>;
		xlnx,is-dual = <0>;
		xlnx,tri-default = <0>;
	};
};

&gem0 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-property/ phy-reset-gpio;
	/delete-property/ phy-reset-active-low;
	status = "okay";
	phy-mode = "gmii";
	phy-handle = <&ethernet_phy>;

	/delete-node/ ethernet-phy@7;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet_phy: ethernet-phy@1 {
			reg = <1>;
			reset-gpios = <&phy_reset_gpio 0 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <50000>;
		};

		gmii_to_rgmii: gmii-to-rgmii@8 {
			compatible = "xlnx,gmii-to-rgmii-1.0";
			reg = <8>;
			phy-handle = <&ethernet_phy>;
			clocks = <&clkc 16>;
		};
	};
};

&gem1 {
	status = "disabled";
};

&sdhci0 {
	status = "okay";
	/* This board's MIO47 card-detect polarity differs from the ZC702 base DT. */
	broken-cd;
	disable-wp;
};

&qspi {
	status = "okay";

	flash@0 {
		/delete-node/ partitions;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			qspi_boot: partition@0 {
				label = "qspi-boot";
				reg = <0x00000000 0x00600000>;
			};

			qspi_data: partition@600000 {
				label = "qspi-data";
				reg = <0x00600000 0x01a00000>;
			};
		};
	};
};

&uart1 {
	status = "okay";
};
